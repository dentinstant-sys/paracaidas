# Config web de Firebase — proyecto caidalibre-prod
#
# El panel admin apunta SOLO a caidalibre-prod.
# El .env real no se sube al repositorio.
# Valores en: Firebase Console → caidalibre-prod → Configuración → Tus apps

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=caidalibre-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=caidalibre-prod
VITE_FIREBASE_STORAGE_BUCKET=caidalibre-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
